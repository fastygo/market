package screens

import (
	"github.com/ui8kit/codegen/generated/templ/compose"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/link"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

templ FooterCatalogNav(s Shell) {
	@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "nav", Class: "flex flex-col gap-4", Attrs: templ.Attributes{"aria-label": s.T("ui.site.footer_catalog")}}}) {
		@compose.Title(compose.TitleProps{As: "2", Size: "sm", TextProps: text.TextProps{}}) {
			{ s.T("ui.site.footer_catalog") }
		}
		@compose.List(compose.ListProps{BoxProps: box.BoxProps{Class: "flex flex-col gap-2"}}) {
			for _, c := range s.Categories {
				@compose.ListItem(compose.ListItemProps{}) {
					@compose.Link(compose.LinkProps{Variant: "muted", Size: "sm", LinkProps: link.LinkProps{Href: CategoryHref(c.Slug)}}) {
						{ c.Title }
					}
				}
			}
		}
	}
}
