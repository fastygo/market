package screens

import (
	"github.com/fastygo/market/internal/catalog"
	"github.com/ui8kit/codegen/generated/templ/compose"
	"github.com/ui8kit/codegen/generated/templ/ui/image"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

// AuthorAvatar is the seller avatar, or the initial on the primary token
// when no avatar is uploaded. size: "md" (48px) or "lg" (96px).
templ AuthorAvatar(a catalog.Seller, size string) {
	if a.AvatarURL != "" {
		@compose.Image(compose.ImageProps{Fit: "cover", ImageProps: image.ImageProps{Src: a.AvatarURL, Alt: "", Class: avatarClass(size) + " shrink-0 rounded-full", Width: avatarPx(size), Height: avatarPx(size)}})
	} else {
		@compose.Inline(compose.InlineProps{TextProps: text.TextProps{Class: avatarClass(size) + " inline-flex shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-foreground", Attrs: templ.Attributes{"aria-hidden": "true", "data-slot": "avatar"}}}) {
			{ initial(a.DisplayName) }
		}
	}
}
