package screens

import (
	"github.com/fastygo/market/internal/catalog"
	"github.com/ui8kit/codegen/generated/templ/compose"
	"github.com/ui8kit/codegen/generated/templ/icons"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/link"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

// AuthorPage is the public seller profile (ADR-0020, /authors/{slug}):
// header with avatar, name, headline and counters, bio, portfolio grid.
// Only the pseudonymous display name and public fields are shown.
templ AuthorPage(s Shell, a catalog.Seller, items []catalog.Product) {
	@Layout(s) {
		@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "section", Class: "flex flex-col gap-12 py-12", Attrs: templ.Attributes{"data-page": "author"}}}) {
			@compose.Group(compose.GroupProps{Gap: "6", BoxProps: box.BoxProps{Class: "flex-col items-start rounded-2xl bg-secondary p-8 text-secondary-foreground sm:flex-row sm:items-center md:p-12"}}) {
				@AuthorAvatar(a, "lg")
				@compose.Stack(compose.StackProps{Gap: "2"}) {
					@compose.Title(compose.TitleProps{As: "1", Size: "3xl", Weight: "bold", TextProps: text.TextProps{Class: "tracking-tight text-secondary-foreground md:text-4xl"}}) {
						{ a.DisplayName }
					}
					if a.Headline != "" {
						@compose.Text(compose.TextProps{Size: "lg", TextProps: text.TextProps{Class: "text-secondary-foreground"}}) {
							{ a.Headline }
						}
					}
					@compose.Group(compose.GroupProps{Gap: "4", BoxProps: box.BoxProps{Class: "flex-wrap pt-2 text-sm text-secondary-foreground"}}) {
						@compose.Inline(compose.InlineProps{TextProps: text.TextProps{Class: "inline-flex items-center gap-2", Attrs: templ.Attributes{"data-slot": "items-count"}}}) {
							@icons.LucideIcon(icons.LucideIconProps{Name: "package", Size: 16})
							{ itemsText(s, a.ItemsCount) }
						}
						if !a.JoinedAt.IsZero() {
							@compose.Inline(compose.InlineProps{TextProps: text.TextProps{Class: "inline-flex items-center gap-2"}}) {
								@icons.LucideIcon(icons.LucideIconProps{Name: "calendar", Size: 16})
								{ joinedText(s, a.JoinedAt) }
							}
						}
						if a.Website != "" {
							@compose.Link(compose.LinkProps{Variant: "nav", Size: "sm", LinkProps: link.LinkProps{Href: a.Website, External: true, Rel: "noopener nofollow ugc", Class: "gap-2 text-secondary-foreground"}}) {
								@icons.LucideIcon(icons.LucideIconProps{Name: "globe", Size: 16})
								{ s.T("ui.author.website") }
							}
						}
					}
				}
			}
			if a.Bio != "" {
				@compose.Stack(compose.StackProps{Gap: "4", BoxProps: box.BoxProps{Class: "max-w-3xl"}}) {
					@compose.Title(compose.TitleProps{As: "2", Size: "2xl", Weight: "bold", TextProps: text.TextProps{Class: "tracking-tight"}}) {
						{ s.T("ui.author.about") }
					}
					for _, para := range paragraphs(a.Bio) {
						@compose.Text(compose.TextProps{TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
							{ para }
						}
					}
				}
			}
			@ItemGrid(s, s.T("ui.author.portfolio"), items, false)
		}
	}
}
