package screens

import (
	"github.com/ui8kit/codegen/generated/templ/compose"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/image"
)

// CoverFrame is the product cover: a fixed-ratio frame, a WebP srcset when
// variants exist, and the original file as the img fallback. priority
// (the LCP cover) loads eagerly with fetchpriority=high; other covers stay lazy.
templ CoverFrame(alt, src, srcset, kind, ratio, class string, priority bool) {
	{{ loading := "lazy" }}
	{{ fetch := "" }}
	{{ aspect := "aspect-[4/3]" }}
	{{ sizes := coverSizes(kind) }}
	if ratio == "1/1" {
		{{ aspect = "aspect-square" }}
	}
	if priority && src != "" {
		{{ loading = "eager" }}
		{{ fetch = "high" }}
	}
	{{ shown := coverSrc(src) }}
	@compose.Box(compose.BoxProps{BoxProps: box.BoxProps{Class: compose.Join(aspect, "relative w-full overflow-hidden", class), Attrs: templ.Attributes{"data-slot": "media-frame"}}}) {
		@image.Picture(image.PictureProps{}) {
			if src != "" && srcset != "" {
				@image.Source(image.SourceProps{Type: "image/webp", SrcSet: srcset, Sizes: sizes})
			}
			@compose.Image(compose.ImageProps{ImageProps: image.ImageProps{Src: shown, Alt: alt, Sizes: sizes, Loading: loading, Decoding: "async", Class: "absolute inset-0 size-full object-cover", Attrs: coverAttrs(fetch)}})
		}
	}
}
