package screens

import (
	"github.com/fastygo/market/internal/catalog"
	"github.com/ui8kit/codegen/generated/templ/compose"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

// CatalogPage: archive title, search, category filter, item grid with
// authors (latte-shop views/pages/shop.latte, Envato style cards).
templ CatalogPage(s Shell, active catalog.Category, q string, products []catalog.Product) {
	@Layout(s) {
		@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "section", Class: "flex flex-col gap-8 pt-16"}}) {
			@compose.Title(compose.TitleProps{As: "1", Size: "3xl", Weight: "bold", TextProps: text.TextProps{Class: "tracking-tight md:text-4xl"}}) {
				if active.Title != "" {
					{ active.Title }
				} else {
					{ s.T("ui.catalog.title") }
				}
			}
			@SearchForm(s, "catalog-search", q)
			@CatalogFilter(s, active.Slug, q)
			if q != "" {
				@compose.Text(compose.TextProps{TextProps: text.TextProps{Class: "text-muted-foreground", Attrs: templ.Attributes{"data-slot": "search-summary", "role": "status"}}}) {
					{ tpl(s.T("ui.catalog.results"), q) }
				}
			}
			@ItemGrid(s, "", products, true)
		}
	}
}
