package screens

import (
	"github.com/fastygo/market/internal/catalog"
	"github.com/ui8kit/codegen/generated/templ/blocks"
	"github.com/ui8kit/codegen/generated/templ/compose"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

// CatalogPage: archive title, category filter, product grid (latte-shop
// views/pages/shop.latte).
templ CatalogPage(s Shell, active catalog.Category, products []catalog.Product) {
	@Layout(s) {
		@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "section", Class: "flex flex-col gap-8 pt-16"}}) {
			@compose.Title(compose.TitleProps{As: "1", Size: "3xl", Weight: "bold", TextProps: text.TextProps{Class: "tracking-tight md:text-4xl"}}) {
				if active.Title != "" {
					{ active.Title }
				} else {
					{ s.T("ui.catalog.title") }
				}
			}
			@CatalogFilter(s, active.Slug)
			@blocks.ProductGrid(blocks.ProductGridProps{Products: cards(products), Labels: cardLabels(s), Cols: "1-3", Rating: "hide", Action: "none", LandmarkLabel: s.T("ui.catalog.title")})
		}
	}
}
