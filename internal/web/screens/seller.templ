package screens

import (
	"github.com/fastygo/market/internal/authoring"
	"github.com/fastygo/market/internal/editorial"
	"github.com/fastygo/market/ui/design"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/image"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

// SellerTodayPage is the vendor home (design screen market.today).
templ SellerTodayPage(s Shell, v SellerHome) {
	@Layout(s) {
		@Frame(s, Section{Kind: "seller", Current: "today"}) {
			@Head(s.T("ui.seller.today"), []string{v.Seller.Name, s.T("ui.status." + v.Seller.Status)}, LinkButton("/seller/items/new", s.T("ui.seller.new_item"), "dark", "plus"))
			@design.Grid(design.GridProps{Class: "items-start gap-4 lg:grid-cols-5", BoxProps: box.BoxProps{}}) {
				@design.Stack(design.StackProps{Class: "min-w-0 gap-4 lg:col-span-3", BoxProps: box.BoxProps{}}) {
					@design.HighlightCard(resume(s, v))
					@design.TaskList(design.TaskListProps{Title: s.T("ui.seller.attention"), HeadingId: "attention-title", Items: attention(s, v)})
				}
				@design.Stack(design.StackProps{Class: "min-w-0 gap-4 lg:col-span-2", BoxProps: box.BoxProps{}}) {
					@design.PlanCard(design.PlanCardProps{Title: s.T("ui.seller.catalog_state"), Text: s.T("ui.seller.catalog_state_text"), Items: statusPlan(s, v.Items)})
				}
			}
			@design.MetricCard(design.MetricCardProps{Title: s.T("ui.finance.this_month"), Value: MinorMoney(v.Balance.ThisMonth, v.Balance.Currency), Text: s.T("ui.seller.earnings_text"), Cta: s.T("ui.seller.open_finance"), Href: "/seller/finance"})
		}
	}
}

// SellerItemsPage lists the seller's products (design SellerItemsTable).
templ SellerItemsPage(s Shell, items []authoring.Item) {
	@Layout(s) {
		@Frame(s, Section{Kind: "seller", Current: "items"}) {
			@Head(s.T("ui.seller.items"), []string{tpl(s.T("ui.seller.items_n"), itoa(len(items)))}, LinkButton("/seller/items/new", s.T("ui.seller.new_item"), "dark", "plus"))
			@design.SellerItemsTable(design.SellerItemsTableProps{Caption: s.T("ui.seller.items"), Edit: s.T("ui.seller.edit"), Empty: s.T("ui.seller.no_items"), Items: sellerItems(s, items),
				Columns: design.SellerItemsTableColumns{Item: s.T("ui.seller.col_item"), Status: s.T("ui.seller.col_status"), Updated: s.T("ui.seller.col_updated"), Actions: s.T("ui.seller.col_actions")}})
		}
	}
}

// SellerItemPage creates or edits a product: card data and prices, status
// actions, cover and gallery, and the description in EditorY.
templ SellerItemPage(s Shell, v ItemForm) {
	@Layout(s) {
		@Frame(s, Section{Kind: "seller", Current: "items"}) {
			if v.New {
				@Head(s.T("ui.seller.new_item"), []string{s.T("ui.seller.new_item_meta")}, LinkButton("/seller/items", s.T("ui.seller.back"), "outline", "arrow-left"))
			} else {
				@Head(v.Item.Title, []string{itemStatus(s, v.Item.Status), fmtDate(v.Item.Updated)}, LinkButton("/seller/items", s.T("ui.seller.back"), "outline", "arrow-left"))
				if v.Item.ReviewNote != "" {
					@Flash(s.T("ui.seller.review_note")+": "+v.Item.ReviewNote, true)
				}
			}
			@design.Grid(design.GridProps{Class: "items-start gap-4 lg:grid-cols-5", BoxProps: box.BoxProps{Attrs: templ.Attributes{"data-item": v.Item.ID}}}) {
				@design.Stack(design.StackProps{Class: "min-w-0 gap-4 lg:col-span-3", BoxProps: box.BoxProps{}}) {
					@Panel(s.T("ui.seller.card"), s.T("ui.seller.card_lead")) {
						@PostForm(itemFormAction(v), v.CSRF, s.T("ui.seller.card")) {
							@Field(F{ID: "item-title", Name: "title", Label: s.T("ui.seller.f_title"), Value: v.Item.Meta.Title, Required: true})
							@design.Grid(design.GridProps{Class: "gap-4 sm:grid-cols-2", BoxProps: box.BoxProps{}}) {
								@Field(F{ID: "item-slug", Name: "slug", Label: s.T("ui.seller.f_slug"), Value: v.Item.Meta.Slug, Hint: s.T("ui.seller.f_slug_hint")})
								@Choice(F{ID: "item-category", Name: "category", Label: s.T("ui.seller.f_category"), Value: v.Item.Meta.Category, Options: categoryOptions(s, v.Categories)})
							}
							@Area(F{ID: "item-excerpt", Name: "excerpt", Label: s.T("ui.seller.f_excerpt"), Value: v.Item.Meta.Excerpt, Rows: "3"})
							@design.Grid(design.GridProps{Class: "gap-4 sm:grid-cols-2", BoxProps: box.BoxProps{}}) {
								@Field(F{ID: "item-stack", Name: "stack", Label: s.T("ui.seller.f_stack"), Value: v.Item.Meta.Stack, Placeholder: "Figma"})
								@Field(F{ID: "item-tags", Name: "tags", Label: s.T("ui.seller.f_tags"), Value: v.Item.Meta.Tags, Hint: s.T("ui.seller.f_tags_hint")})
							}
							@Field(F{ID: "item-demo", Name: "demo_url", Label: s.T("ui.seller.f_demo"), Type: "url", Value: v.Item.Meta.DemoURL, Placeholder: "https://"})
							@design.Grid(design.GridProps{Class: "gap-4 sm:grid-cols-2", BoxProps: box.BoxProps{}}) {
								@Field(F{ID: "item-price", Name: "price", Label: s.T("ui.seller.f_price"), Type: "number", Min: "0", Step: "0.01", Value: minorInput(v.Item.Meta.Price), Hint: s.T("ui.seller.f_price_hint")})
								@Field(F{ID: "item-extended", Name: "extended", Label: s.T("ui.seller.f_extended"), Type: "number", Min: "0", Step: "0.01", Value: minorInput(v.Item.Meta.Extended), Hint: s.T("ui.seller.f_extended_hint")})
							}
							@Submit(s.T("ui.common.save"))
						}
					}
					if !v.New {
						@Panel(s.T("ui.seller.description"), s.T("ui.seller.description_lead")) {
							@PostForm(ItemEditHref(v.Item.ID), v.CSRF, s.T("ui.seller.save_description")) {
								@Hidden("version", versionString(v.Item.Version))
								@Area(F{ID: "description", Name: "description", Label: s.T("ui.seller.description"), Value: v.Item.Description, Rows: "14"})
								@design.Box(design.BoxProps{BoxProps: box.BoxProps{Attrs: templ.Attributes{"id": "editory-root"}}})
								@Submit(s.T("ui.seller.save_description"))
							}
						}
					}
				}
				if !v.New {
					@design.Stack(design.StackProps{Class: "min-w-0 gap-4 lg:col-span-2", BoxProps: box.BoxProps{}}) {
						@Panel(s.T("ui.seller.publication"), s.T("ui.seller.publication_lead")) {
							@design.Badge(design.BadgeProps{Tone: statusTone(v.Item.Status), TextProps: text.TextProps{}}) {
								{ itemStatus(s, v.Item.Status) }
							}
							@InlineForm(SellerItemHref(v.Item.ID)+"/status", v.CSRF) {
								for _, a := range itemActions(v.Item) {
									@Act("action", a, actLabel(s, a), actVariant(a))
								}
							}
							if v.Item.Status == "published" {
								@LinkButton(ProductHref(v.Item.Slug), s.T("ui.seller.view_public"), "ghost", "external-link")
							}
						}
						@Panel(s.T("ui.seller.cover"), s.T("ui.seller.cover_lead")) {
							@design.Image(design.ImageProps{Class: "aspect-[4/3] w-full rounded-md border border-border object-cover", ImageProps: image.ImageProps{Src: coverSrc(v.Item.CoverURL), Alt: "", Width: "400", Height: "300"}})
							@UploadForm(SellerItemHref(v.Item.ID)+"/cover", v.CSRF, s.T("ui.seller.cover")) {
								@Field(F{ID: "cover-file", Name: "file", Label: s.T("ui.seller.choose_image"), Type: "file", Required: true, Hint: s.T("ui.seller.image_hint")})
								@Submit(s.T("ui.seller.upload"))
							}
						}
						@Panel(s.T("ui.seller.gallery"), s.T("ui.seller.gallery_lead")) {
							@design.Grid(design.GridProps{Class: "grid-cols-3 gap-2", BoxProps: box.BoxProps{}}) {
								for _, img := range v.Item.Images {
									@design.Image(design.ImageProps{Class: "aspect-[4/3] w-full rounded-md border border-border object-cover", ImageProps: image.ImageProps{Src: img.URL, Alt: "", Width: "120", Height: "90", Loading: "lazy"}})
								}
							}
							@UploadForm(SellerItemHref(v.Item.ID)+"/gallery", v.CSRF, s.T("ui.seller.gallery")) {
								@Field(F{ID: "gallery-file", Name: "file", Label: s.T("ui.seller.choose_image"), Type: "file", Required: true, Hint: s.T("ui.seller.image_hint")})
								@Submit(s.T("ui.seller.upload"))
							}
						}
						@Panel(s.T("ui.seller.releases"), s.T("ui.seller.releases_lead")) {
							if v.ReleasesOn {
								@Rows(releaseRows(s, v.Releases), s.T("ui.release.empty"), releaseActions(s, v))
								@UploadForm(SellerItemHref(v.Item.ID)+"/releases", v.CSRF, s.T("ui.seller.releases")) {
									@Field(F{ID: "release-version", Name: "version", Label: s.T("ui.release.version"), Required: true, Hint: s.T("ui.release.version_hint")})
									@Field(F{ID: "release-changelog", Name: "changelog", Label: s.T("ui.release.changelog"), Type: "textarea", Rows: "3"})
									@Field(F{ID: "release-file", Name: "file", Label: s.T("ui.release.file"), Type: "file", Required: true, Hint: s.T("ui.release.file_hint")})
									@Submit(s.T("ui.release.upload"))
								}
							} else {
								@design.Badge(design.BadgeProps{Tone: "warning", TextProps: text.TextProps{}}) {
									{ s.T("ui.release.operator") }
								}
							}
						}
					}
				}
			}
		}
	}
}

// ReleasePublish is the publish button of a draft release.
templ ReleasePublish(action, csrf, label string) {
	@InlineForm(action, csrf) {
		@Act("action", "publish", label, "dark")
	}
}

// SellerMediaPage shows every image of the seller's products.
templ SellerMediaPage(s Shell, items []authoring.Item, csrf string) {
	@Layout(s) {
		@Frame(s, Section{Kind: "seller", Current: "media"}) {
			@Head(s.T("ui.seller.media"), []string{s.T("ui.seller.media_meta")}, nil)
			@Panel(s.T("ui.seller.media_upload"), s.T("ui.seller.media_upload_lead")) {
				@UploadForm("/seller/media", csrf, s.T("ui.seller.media_upload")) {
					@Choice(F{ID: "media-item", Name: "item", Label: s.T("ui.seller.col_item"), Options: itemOptions(items), Required: true})
					@Field(F{ID: "media-file", Name: "file", Label: s.T("ui.seller.choose_image"), Type: "file", Required: true, Hint: s.T("ui.seller.image_hint")})
					@Submit(s.T("ui.seller.upload"))
				}
			}
			for _, it := range items {
				if it.CoverURL != "" || len(it.Images) > 0 {
					@Panel(it.Title, itoa(len(it.Images)+boolInt(it.CoverURL != ""))+" "+s.T("ui.seller.files")) {
						@design.Grid(design.GridProps{Class: "grid-cols-2 gap-3 sm:grid-cols-4", BoxProps: box.BoxProps{}}) {
							if it.CoverURL != "" {
								@design.Image(design.ImageProps{Class: "aspect-[4/3] w-full rounded-md border-2 border-primary object-cover", ImageProps: image.ImageProps{Src: it.CoverURL, Alt: it.Title, Width: "200", Height: "150", Loading: "lazy"}})
							}
							for _, img := range it.Images {
								@design.Image(design.ImageProps{Class: "aspect-[4/3] w-full rounded-md border border-border object-cover", ImageProps: image.ImageProps{Src: img.URL, Alt: "", Width: "200", Height: "150", Loading: "lazy"}})
							}
						}
					}
				}
			}
		}
	}
}

// FinancePage is sales and payouts for a seller or a partner (design
// screen market.finance). Payout requests are data only (ADR-0035).
templ FinancePage(s Shell, v FinanceView) {
	@Layout(s) {
		@Frame(s, financeSection(v)) {
			@Head(s.T("ui.finance.title"), []string{s.T("ui.finance.meta")}, nil)
			@design.StatGrid(design.StatGridProps{Items: balanceStats(s, v.Balance, v.Party == "partner"), Label: s.T("ui.finance.title")})
			@design.Grid(design.GridProps{Class: "items-start gap-4 lg:grid-cols-2", BoxProps: box.BoxProps{}}) {
				if v.Party == "seller" {
					@design.SplitBar(design.SplitBarProps{Title: s.T("ui.finance.split"), Label: s.T("ui.finance.split_label"), Note: s.T("ui.finance.split_note"), Rows: splitRows(s, v.Balance)})
				}
				@Panel(s.T("ui.finance.request"), s.T("ui.finance.request_lead")) {
					@PostForm(financeAction(v), v.CSRF, s.T("ui.finance.request")) {
						@Field(F{ID: "payout-amount", Name: "amount", Label: s.T("ui.finance.amount"), Type: "number", Min: "1", Step: "0.01", Value: minorInput(v.Balance.Available), Required: true})
						@Area(F{ID: "payout-note", Name: "note", Label: s.T("ui.finance.note"), Rows: "2", Hint: s.T("ui.finance.note_hint")})
						@Submit(s.T("ui.finance.request_submit"))
					}
				}
			}
			@Panel(s.T("ui.finance.payouts"), "") {
				@Rows(payoutRows(s, v.Payouts), s.T("ui.finance.no_payouts"), nil)
			}
			if v.Party == "seller" {
				@design.OrdersTable(design.OrdersTableProps{Title: s.T("ui.finance.sales"), Columns: []string{s.T("ui.finance.col_order"), s.T("ui.finance.col_item"), s.T("ui.finance.col_date"), s.T("ui.finance.col_status"), s.T("ui.finance.col_amount"), s.T("ui.finance.col_net")}, Keys: []string{"number", "item", "date", "status", "amount", "net"}, Rows: saleRows(s, v.Sales, false)})
			} else {
				@design.OrdersTable(design.OrdersTableProps{Title: s.T("ui.partner.referred"), Columns: []string{s.T("ui.finance.col_order"), s.T("ui.finance.col_date"), s.T("ui.finance.col_status"), s.T("ui.finance.col_amount")}, Keys: []string{"number", "date", "status", "amount"}, Rows: saleRows(s, v.Sales, true)})
			}
		}
	}
}

// SellerReviewsPage lists reviews of the seller's products.
templ SellerReviewsPage(s Shell, rs []editorial.Review) {
	@Layout(s) {
		@Frame(s, Section{Kind: "seller", Current: "reviews"}) {
			@Head(s.T("ui.seller.reviews"), []string{s.T("ui.seller.reviews_meta")}, nil)
			@Rows(reviewModRows(s, rs), s.T("ui.product.no_reviews"), nil)
		}
	}
}

// SellerTeamPage manages staff members.
templ SellerTeamPage(s Shell, v TeamView) {
	@Layout(s) {
		@Frame(s, Section{Kind: "seller", Current: "team"}) {
			@Head(s.T("ui.team.title"), []string{s.T("ui.team.meta")}, nil)
			@Rows(memberRows(s, v.Members), "", teamActions(s, v))
			if v.Owner {
				@Panel(s.T("ui.team.add"), s.T("ui.team.add_lead")) {
					@PostForm("/seller/team", v.CSRF, s.T("ui.team.add")) {
						@Field(F{ID: "team-email", Name: "email", Label: s.T("ui.account.email"), Type: "email", Required: true})
						@Submit(s.T("ui.team.add_submit"))
					}
				}
			}
		}
	}
}

templ teamRemove(s Shell, v TeamView, i int) {
	@InlineForm("/seller/team/remove", v.CSRF) {
		@Hidden("user", v.Members[i].UserID)
		@Act("do", "remove", s.T("ui.team.remove"), "outline")
	}
}

// SellerStorePage edits the public seller profile.
templ SellerStorePage(s Shell, v StoreView) {
	@Layout(s) {
		@Frame(s, Section{Kind: "seller", Current: "store"}) {
			@Head(s.T("ui.store.title"), []string{AuthorHref(v.Store.Slug), s.T("ui.status." + v.Store.Status)}, LinkButton(AuthorHref(v.Store.Slug), s.T("ui.store.view"), "outline", "external-link"))
			@Panel(s.T("ui.store.profile"), s.T("ui.store.profile_lead")) {
				@PostForm("/seller/store", v.CSRF, s.T("ui.store.profile")) {
					@Field(F{ID: "store-display", Name: "display_name", Label: s.T("ui.store.name"), Value: v.Store.DisplayName, Required: true})
					@Field(F{ID: "store-headline", Name: "headline", Label: s.T("ui.store.headline"), Value: v.Store.Headline})
					@Area(F{ID: "store-bio", Name: "bio", Label: s.T("ui.store.bio"), Value: v.Store.Bio, Rows: "5"})
					@Field(F{ID: "store-website", Name: "website", Label: s.T("ui.roles.website"), Type: "url", Value: v.Store.Website, Placeholder: "https://"})
					@Submit(s.T("ui.common.save"))
				}
			}
			@Panel(s.T("ui.store.legal"), s.T("ui.store.legal_lead")) {
				@design.Badge(design.BadgeProps{Tone: "warning", TextProps: text.TextProps{}}) {
					{ s.T("ui.common.stub") }
				}
			}
		}
	}
}
