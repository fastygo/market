package screens

import (
	"github.com/fastygo/market/ui/design"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/form"
	"github.com/ui8kit/codegen/generated/templ/ui/input"
	"github.com/ui8kit/codegen/generated/templ/ui/link"
)

// Layout is the document shell. html, head and body have no UI8Kit
// primitive (recorded exception, as in ui8kit/site); everything inside body
// is primitives. The inline theme script in head is part of that shell
// (it must run before first paint).
templ Layout(s Shell) {
	<!DOCTYPE html>
	<html lang={ s.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ s.pageTitle() }</title>
			<meta name="description" content={ s.metaDescription() }/>
			<meta property="og:site_name" content={ s.Brand }/>
			<meta property="og:title" content={ s.pageTitle() }/>
			<meta property="og:description" content={ s.metaDescription() }/>
			<meta property="og:type" content="website"/>
			if s.NoIndex {
				<meta name="robots" content="noindex"/>
			}
			if s.canonical() != "" {
				<link rel="canonical" href={ s.canonical() }/>
				<meta property="og:url" content={ s.canonical() }/>
			}
			if s.ogImage() != "" {
				<meta property="og:image" content={ s.ogImage() }/>
			}
			if s.JSONLD != nil {
				@templ.JSONScript("ld-json", s.JSONLD).WithType("application/ld+json")
			}
			if s.EditorProps != nil {
				@templ.JSONScript("editory-props", s.EditorProps).WithType("application/json")
			}
			<meta name="color-scheme" content="light dark"/>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<link rel="icon" href="/favicon.ico" sizes="any"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			for _, href := range s.FontPreloads {
				<link rel="preload" href={ href } as="font" type="font/woff2" crossorigin="anonymous"/>
			}
			if s.LCPSrcset != "" {
				<link rel="preload" as="image" type="image/webp" imagesrcset={ s.LCPSrcset } imagesizes={ s.LCPSizes }/>
			} else if s.LCPImage != "" {
				<link rel="preload" as="image" href={ s.LCPImage }/>
			}
			<link rel="stylesheet" href={ s.CSSHref }/>
			if s.EditorCSS != "" {
				<link rel="stylesheet" href={ s.EditorCSS }/>
			}
			<script nonce={ s.CSPNonce }>
				/* Theme before first paint (no flash): stored choice, else the system preference. app.js toggles it. */
				(function () {
					var d = document.documentElement, t = null;
					try { t = localStorage.getItem("theme"); } catch (e) {}
					var dark = t === "dark" || (t !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
					d.classList.toggle("dark", dark);
					d.style.colorScheme = dark ? "dark" : "light";
				})();
			</script>
		</head>
		<body class="min-h-screen bg-background text-foreground">
			@design.Block(design.BlockProps{Class: "flex min-h-screen flex-col", BoxProps: box.BoxProps{}}) {
				@design.Link(design.LinkProps{Class: "sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-card focus:px-4 focus:py-2 focus:text-sm focus:shadow-lg", LinkProps: link.LinkProps{Href: "#main-content"}}) {
					{ s.T("ui.site.skip") }
				}
				@design.SiteHeader(headerProps(s))
				@design.Block(design.BlockProps{Class: "flex-1 outline-none", Tag: "main", BoxProps: box.BoxProps{Attrs: templ.Attributes{"id": "main-content", "tabindex": "-1"}}}) {
					{ children... }
				}
				if s.Workspace {
					@design.SellerFooter(sellerFooterProps(s))
				} else {
					@design.SiteFooter(footerProps(s))
				}
				@design.MobileMenu(mobileProps(s))
				if s.Viewer.Signed {
					@design.Form(design.FormProps{Class: "hidden", FormProps: form.FormProps{ID: "signout-form", Action: "/account/logout", Method: "post"}}) {
						@Hidden("csrf", s.Viewer.CSRF)
					}
				}
				@design.Toast(design.ToastProps{Text: s.Toast})
			}
			<script src={ s.AppJS } defer nonce={ s.CSPNonce }></script>
			if s.EditorJS != "" {
				<script type="module" src={ s.EditorJS } nonce={ s.CSPNonce }></script>
			}
		</body>
	</html>
}

// Hidden is a hidden form field.
templ Hidden(name, value string) {
	@input.Input(input.InputProps{Type: "hidden", Name: name, Value: strPtr(value)})
}
