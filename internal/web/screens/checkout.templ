package screens

import (
	"github.com/fastygo/market/internal/catalog"
	"github.com/ui8kit/codegen/generated/templ/blocks"
	"github.com/ui8kit/codegen/generated/templ/compose"
	"github.com/ui8kit/codegen/generated/templ/icons"
	uiutils "github.com/ui8kit/codegen/generated/templ/orgutils"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/button"
	"github.com/ui8kit/codegen/generated/templ/ui/form"
	"github.com/ui8kit/codegen/generated/templ/ui/input"
	"github.com/ui8kit/codegen/generated/templ/ui/label"
	"github.com/ui8kit/codegen/generated/templ/ui/link"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

// BuyForm is the product page checkout (signed-in buyer or guest email).
templ BuyForm(s Shell, p catalog.Product, v CheckoutView) {
	@compose.Form(compose.FormProps{FormProps: form.FormProps{Action: "/checkout/form", Method: "post", AriaLabel: s.T("ui.checkout.title"), Class: "rounded-xl border border-border bg-card p-6", Attrs: templ.Attributes{"data-form": "checkout"}}}) {
		@Hidden("csrf", v.CSRF)
		@Hidden("key", v.Key)
		@Hidden("product", p.Slug)
		@Hidden("license", "regular")
		if v.ErrorKey != "" {
			@compose.Text(compose.TextProps{Size: "sm", Weight: "semibold", TextProps: text.TextProps{Class: "text-destructive", Attrs: templ.Attributes{"role": "alert"}}}) {
				{ s.T(v.ErrorKey) }
			}
		}
		if v.Signed {
			@compose.Text(compose.TextProps{Size: "sm", TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
				{ s.T("ui.checkout.signed_in") }
				@compose.Inline(compose.InlineProps{TextProps: text.TextProps{Class: "font-semibold text-foreground"}}) {
					{ v.Email }
				}
			}
		} else {
			@blocks.Field(blocks.FieldProps{Label: s.T("ui.checkout.email"), HtmlFor: "buy-email", Hint: s.T("ui.checkout.email_hint")}) {
				@compose.Input(compose.InputProps{InputProps: input.InputProps{Type: "email", ID: "buy-email", Name: "email", Value: strPtr(v.Email), Required: true, Attrs: templ.Attributes{"autocomplete": "email"}}})
			}
		}
		@compose.Group(compose.GroupProps{Gap: "2"}) {
			@compose.Input(compose.InputProps{InputProps: input.InputProps{Type: "checkbox", ID: "buy-terms", Name: "terms", Value: strPtr("1"), Required: true, Class: "size-4"}})
			@compose.Label(compose.LabelProps{LabelProps: label.LabelProps{For: "buy-terms", Class: "font-normal"}}) {
				{ s.T("ui.checkout.terms") }
			}
		}
		@compose.Button(compose.ButtonProps{Size: "lg", ButtonProps: button.ButtonProps{Type: "submit", Class: "gap-2", Attrs: templ.Attributes{"data-action": "buy"}}}) {
			@icons.LucideIcon(icons.LucideIconProps{Name: "shopping-cart", Size: 20})
			{ s.T("ui.checkout.buy") + " " + uiutils.Money(float64(p.Price.Minor), p.Price.Currency) }
		}
	}
}

// ReturnPage is shown when the buyer comes back from the payment page.
templ ReturnPage(s Shell, v ReturnView) {
	@Layout(s) {
		@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "section", Class: "flex flex-col items-center gap-6 py-16 text-center", Attrs: templ.Attributes{"data-page": "return", "data-state": v.State}}}) {
			@compose.Title(compose.TitleProps{As: "1", Size: "2xl", TextProps: text.TextProps{}}) {
				{ s.T(returnKey(v.State)) }
			}
			if v.State == "paid" {
				@compose.Text(compose.TextProps{TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
					{ s.T("ui.checkout.return_email") }
				}
			}
			if v.OrderHref != "" {
				@compose.LinkButton(compose.LinkButtonProps{LinkProps: link.LinkProps{Href: v.OrderHref}}) {
					{ s.T("ui.checkout.open_order") }
				}
			} else {
				@compose.LinkButton(compose.LinkButtonProps{Variant: "outline", LinkProps: link.LinkProps{Href: "/account"}}) {
					{ s.T("ui.site.account") }
				}
			}
		}
	}
}

// FakePayPage plays the provider payment page (development only).
templ FakePayPage(s Shell, v FakePayView) {
	@Layout(s) {
		@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "section", Class: "mx-auto flex w-full max-w-md flex-col gap-6 py-16", Attrs: templ.Attributes{"data-page": "fakepay"}}}) {
			@compose.Title(compose.TitleProps{As: "1", Size: "2xl", TextProps: text.TextProps{}}) {
				{ s.T("ui.fakepay.title") }
			}
			@compose.Text(compose.TextProps{TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
				{ s.T("ui.fakepay.lead") }
			}
			@compose.Text(compose.TextProps{Size: "xl", Weight: "semibold", TextProps: text.TextProps{}}) {
				{ s.T("ui.fakepay.amount") + ": " + uiutils.Money(float64(v.Amount.Minor), v.Amount.Currency) }
			}
			@compose.Group(compose.GroupProps{Gap: "4"}) {
				@compose.Form(compose.FormProps{FormProps: form.FormProps{Action: "/fakepay/" + v.ID + "/succeed", Method: "post", Class: "flex"}}) {
					@compose.Button(compose.ButtonProps{ButtonProps: button.ButtonProps{Type: "submit", Attrs: templ.Attributes{"data-action": "pay"}}}) {
						{ s.T("ui.fakepay.pay") }
					}
				}
				@compose.Form(compose.FormProps{FormProps: form.FormProps{Action: "/fakepay/" + v.ID + "/cancel", Method: "post", Class: "flex"}}) {
					@compose.Button(compose.ButtonProps{Variant: "outline", ButtonProps: button.ButtonProps{Type: "submit"}}) {
						{ s.T("ui.fakepay.cancel") }
					}
				}
			}
		}
	}
}
