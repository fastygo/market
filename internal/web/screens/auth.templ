package screens

import (
	"github.com/fastygo/market/ui/design"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

// SignInPage: magic link, password and account creation in the design
// style (ADR-0027, ADR-0035). Password sign-in and the link request are
// rate limited; the link and register forms answer the same way for
// known and unknown emails.
templ SignInPage(s Shell, v SignInView) {
	@Layout(s) {
		@Page("flex flex-col gap-8 pb-14 pt-10 md:pt-14") {
			@design.Stack(design.StackProps{Class: "max-w-2xl gap-3", BoxProps: box.BoxProps{Attrs: templ.Attributes{"data-page": "signin"}}}) {
				@design.Title(design.TitleProps{Size: "page", As: 1, TextProps: text.TextProps{}}) {
					if v.Register {
						{ s.T("ui.auth.register_title") }
					} else {
						{ s.T("ui.account.signin_title") }
					}
				}
				@design.Text(design.TextProps{Tone: "muted", TextProps: text.TextProps{}}) {
					{ s.T("ui.account.signin_lead") }
				}
			}
			if v.ErrorKey != "" {
				@Flash(s.T(v.ErrorKey), true)
			}
			if v.InfoKey != "" {
				@Flash(s.T(v.InfoKey), false)
			}
			@design.Grid(design.GridProps{Class: "items-start gap-6 lg:grid-cols-2", BoxProps: box.BoxProps{}}) {
				@design.Stack(design.StackProps{Class: "gap-6", BoxProps: box.BoxProps{}}) {
					if v.Register && !v.Closed {
						@registerCard(s, v)
					}
					@Panel(s.T("ui.account.signin_link"), s.T("ui.auth.link_lead")) {
						@PostForm("/account/link", v.CSRF, s.T("ui.account.signin_link")) {
							@Hidden("next", v.Next)
							@Field(F{ID: "link-email", Name: "email", Label: s.T("ui.account.email"), Type: "email", Value: v.Email, Required: true, Auto: "email"})
							@Submit(s.T("ui.account.send_link"))
						}
					}
					@Panel(s.T("ui.account.signin_password"), s.T("ui.auth.password_lead")) {
						@PostForm("/account/login", v.CSRF, s.T("ui.account.signin_password")) {
							@Hidden("next", v.Next)
							@Field(F{ID: "login-email", Name: "email", Label: s.T("ui.account.email"), Type: "email", Value: v.Email, Required: true, Auto: "email"})
							@Field(F{ID: "login-password", Name: "password", Label: s.T("ui.account.password"), Type: "password", Required: true, Auto: "current-password"})
							@Submit(s.T("ui.account.signin_password"))
						}
					}
				}
				@design.Stack(design.StackProps{Class: "gap-6", BoxProps: box.BoxProps{}}) {
					if v.Closed {
						@Panel(s.T("ui.auth.register_title"), s.T("ui.auth.signups_closed"))
					} else if !v.Register {
						@registerCard(s, v)
					}
					@design.CheckList(design.CheckListProps{Title: s.T("ui.auth.why_title"), Text: s.T("ui.auth.why_text"), Tone: "outline", HeadingId: "why-title",
						Checks: []design.Check{{Icon: "package", Text: s.T("ui.auth.why_1")}, {Icon: "download", Text: s.T("ui.auth.why_2")}, {Icon: "store", Text: s.T("ui.auth.why_3")}, {Icon: "handshake", Text: s.T("ui.auth.why_4")}},
						Cta: s.T("ui.auth.why_cta"), Href: "/pages/sell"})
				}
			}
		}
	}
}

templ registerCard(s Shell, v SignInView) {
	@Panel(s.T("ui.auth.register_title"), s.T("ui.auth.register_lead")) {
		@PostForm("/account/register", v.CSRF, s.T("ui.auth.register_title")) {
			@Hidden("next", v.Next)
			@Field(F{ID: "register-email", Name: "email", Label: s.T("ui.account.email"), Type: "email", Value: v.Email, Required: true, Auto: "email"})
			@Check(F{ID: "register-terms", Name: "terms", Label: s.T("ui.auth.accept_terms"), Required: true}, false)
			@Submit(s.T("ui.auth.register_submit")) {
				@LinkButton("/pages/terms", s.T("ui.footer.terms"), "ghost", "file-text")
			}
		}
	}
}
