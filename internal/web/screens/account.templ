package screens

import (
	"github.com/fastygo/market/internal/account"
	"github.com/ui8kit/codegen/generated/templ/blocks"
	"github.com/ui8kit/codegen/generated/templ/compose"
	"github.com/ui8kit/codegen/generated/templ/icons"
	uiutils "github.com/ui8kit/codegen/generated/templ/orgutils"
	"github.com/ui8kit/codegen/generated/templ/ui/box"
	"github.com/ui8kit/codegen/generated/templ/ui/button"
	"github.com/ui8kit/codegen/generated/templ/ui/form"
	"github.com/ui8kit/codegen/generated/templ/ui/input"
	"github.com/ui8kit/codegen/generated/templ/ui/link"
	"github.com/ui8kit/codegen/generated/templ/ui/text"
)

// Hidden is a hidden form field.
templ Hidden(name, value string) {
	@compose.Input(compose.InputProps{InputProps: input.InputProps{Type: "hidden", Name: name, Value: strPtr(value)}})
}

// SignInPage: password sign-in and the magic link request (buyer cabinet,
// separate from the PocketBase admin).
templ SignInPage(s Shell, v SignInView) {
	@Layout(s) {
		@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "section", Class: "mx-auto flex w-full max-w-md flex-col gap-6 py-12", Attrs: templ.Attributes{"data-page": "signin"}}}) {
			@compose.Stack(compose.StackProps{Gap: "2"}) {
				@compose.Title(compose.TitleProps{As: "1", Size: "2xl", Weight: "bold", TextProps: text.TextProps{}}) {
					{ s.T("ui.account.signin_title") }
				}
				@compose.Text(compose.TextProps{TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
					{ s.T("ui.account.signin_lead") }
				}
			}
			if v.ErrorKey != "" {
				@compose.Text(compose.TextProps{Size: "sm", Weight: "semibold", TextProps: text.TextProps{Class: "text-destructive", Attrs: templ.Attributes{"role": "alert"}}}) {
					{ s.T(v.ErrorKey) }
				}
			}
			if v.InfoKey != "" {
				@compose.Text(compose.TextProps{Size: "sm", TextProps: text.TextProps{Class: "rounded border border-border bg-muted p-4", Attrs: templ.Attributes{"role": "status"}}}) {
					{ s.T(v.InfoKey) }
				}
			}
			@compose.Card(compose.CardProps{BoxProps: box.BoxProps{}}) {
				@compose.Form(compose.FormProps{FormProps: form.FormProps{Action: "/account/login", Method: "post", AriaLabel: s.T("ui.account.signin_password")}}) {
					@Hidden("csrf", v.CSRF)
					@Hidden("next", v.Next)
					@blocks.Field(blocks.FieldProps{Label: s.T("ui.account.email"), HtmlFor: "login-email"}) {
						@compose.Input(compose.InputProps{InputProps: input.InputProps{Type: "email", ID: "login-email", Name: "email", Value: strPtr(v.Email), Required: true, Attrs: templ.Attributes{"autocomplete": "email"}}})
					}
					@blocks.Field(blocks.FieldProps{Label: s.T("ui.account.password"), HtmlFor: "login-password"}) {
						@compose.Input(compose.InputProps{InputProps: input.InputProps{Type: "password", ID: "login-password", Name: "password", Required: true, Attrs: templ.Attributes{"autocomplete": "current-password"}}})
					}
					@compose.Button(compose.ButtonProps{ButtonProps: button.ButtonProps{Type: "submit"}}) {
						{ s.T("ui.account.signin_password") }
					}
				}
			}
			@compose.Card(compose.CardProps{Variant: "muted", BoxProps: box.BoxProps{}}) {
				@compose.Form(compose.FormProps{FormProps: form.FormProps{Action: "/account/link", Method: "post", AriaLabel: s.T("ui.account.send_link")}}) {
					@compose.Text(compose.TextProps{Size: "sm", TextProps: text.TextProps{}}) {
						{ s.T("ui.account.or") }
					}
					@Hidden("csrf", v.CSRF)
					@Hidden("next", v.Next)
					@blocks.Field(blocks.FieldProps{Label: s.T("ui.account.email"), HtmlFor: "link-email"}) {
						@compose.Input(compose.InputProps{InputProps: input.InputProps{Type: "email", ID: "link-email", Name: "email", Value: strPtr(v.Email), Required: true, Attrs: templ.Attributes{"autocomplete": "email"}}})
					}
					@compose.Button(compose.ButtonProps{Variant: "outline", ButtonProps: button.ButtonProps{Type: "submit", Class: "gap-2"}}) {
						@icons.LucideIcon(icons.LucideIconProps{Name: "mail", Size: 16})
						{ s.T("ui.account.send_link") }
					}
				}
			}
		}
	}
}

// AccountBar: who is signed in, and sign out (a POST form with CSRF).
templ AccountBar(s Shell, a AccountView) {
	@compose.Group(compose.GroupProps{Gap: "4", Justify: "between", BoxProps: box.BoxProps{Class: "flex-wrap border-b border-border pb-4"}}) {
		@compose.Text(compose.TextProps{Size: "sm", TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
			{ s.T("ui.account.signed_in_as") }
			@compose.Inline(compose.InlineProps{TextProps: text.TextProps{Class: "font-semibold text-foreground"}}) {
				{ a.Email }
			}
		}
		@compose.Group(compose.GroupProps{Gap: "4", BoxProps: box.BoxProps{Class: "flex-wrap"}}) {
			if a.Seller {
				@compose.Link(compose.LinkProps{Size: "sm", LinkProps: link.LinkProps{Href: "/account/items", Class: "flex items-center gap-2"}}) {
					{ s.T("ui.seller.items") }
				}
			}
			@compose.Link(compose.LinkProps{Size: "sm", LinkProps: link.LinkProps{Href: "/account/orders", Class: "flex items-center gap-2"}}) {
				{ s.T("ui.account.orders") }
			}
			@compose.Form(compose.FormProps{FormProps: form.FormProps{Action: "/account/logout", Method: "post", Class: "flex"}}) {
				@Hidden("csrf", a.CSRF)
				@compose.Button(compose.ButtonProps{Variant: "ghost", Size: "sm", ButtonProps: button.ButtonProps{Type: "submit", Class: "gap-2"}}) {
					@icons.LucideIcon(icons.LucideIconProps{Name: "log-out", Size: 16})
					{ s.T("ui.account.signout") }
				}
			}
		}
	}
}

// OrdersPage lists the buyer's orders.
templ OrdersPage(s Shell, a AccountView, orders []account.Order) {
	@Layout(s) {
		@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "section", Class: "flex flex-col gap-6 py-12", Attrs: templ.Attributes{"data-page": "orders"}}}) {
			@AccountBar(s, a)
			@compose.Title(compose.TitleProps{As: "1", Size: "2xl", Weight: "bold", TextProps: text.TextProps{}}) {
				{ s.T("ui.account.orders") }
			}
			if len(orders) == 0 {
				@compose.Text(compose.TextProps{TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
					{ s.T("ui.account.orders_empty") }
				}
			}
			@compose.List(compose.ListProps{BoxProps: box.BoxProps{Class: "flex flex-col gap-4"}}) {
				for _, o := range orders {
					@compose.ListItem(compose.ListItemProps{BoxProps: box.BoxProps{Class: "flex flex-wrap items-center justify-between gap-4 rounded border border-border bg-card p-4", Attrs: templ.Attributes{"data-order": o.Number}}}) {
						@compose.Stack(compose.StackProps{Gap: "1"}) {
							@compose.Text(compose.TextProps{Weight: "semibold", TextProps: text.TextProps{}}) {
								{ s.T("ui.account.order") + " " + o.Number }
							}
							@compose.Text(compose.TextProps{Size: "sm", TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
								{ fmtDate(o.Created) + " | " + uiutils.Money(float64(o.Total.Minor), o.Total.Currency) }
							}
						}
						@compose.Group(compose.GroupProps{Gap: "4"}) {
							@compose.Badge(compose.BadgeProps{Variant: "secondary", TextProps: text.TextProps{Attrs: templ.Attributes{"data-status": o.Status}}}) {
								{ s.T(orderStatusKey(o.Status)) }
							}
							@compose.LinkButton(compose.LinkButtonProps{Variant: "outline", Size: "sm", LinkProps: link.LinkProps{Href: OrderHref(o.Number)}}) {
								{ s.T("ui.account.order_open") }
							}
						}
					}
				}
			}
		}
	}
}

// OrderPage is one order with download buttons for active entitlements.
templ OrderPage(s Shell, a AccountView, o account.Order) {
	@Layout(s) {
		@compose.Block(compose.BlockProps{BoxProps: box.BoxProps{Tag: "section", Class: "flex flex-col gap-6 py-12", Attrs: templ.Attributes{"data-page": "order", "data-order": o.Number}}}) {
			@AccountBar(s, a)
			@compose.Link(compose.LinkProps{Size: "sm", LinkProps: link.LinkProps{Href: "/account/orders", Class: "flex items-center gap-2"}}) {
				@icons.LucideIcon(icons.LucideIconProps{Name: "arrow-left", Size: 16})
				{ s.T("ui.account.back") }
			}
			@compose.Group(compose.GroupProps{Gap: "4", BoxProps: box.BoxProps{Class: "flex-wrap"}}) {
				@compose.Title(compose.TitleProps{As: "1", Size: "2xl", Weight: "bold", TextProps: text.TextProps{}}) {
					{ s.T("ui.account.order") + " " + o.Number }
				}
				@compose.Badge(compose.BadgeProps{Variant: "secondary", TextProps: text.TextProps{Attrs: templ.Attributes{"data-status": o.Status}}}) {
					{ s.T(orderStatusKey(o.Status)) }
				}
			}
			@compose.Text(compose.TextProps{Size: "sm", TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
				{ s.T("ui.account.order_date") + ": " + fmtDate(o.Created) + " | " + s.T("ui.account.order_total") + ": " + uiutils.Money(float64(o.Total.Minor), o.Total.Currency) }
			}
			@compose.Title(compose.TitleProps{As: "2", Size: "lg", TextProps: text.TextProps{}}) {
				{ s.T("ui.account.items") }
			}
			@compose.List(compose.ListProps{BoxProps: box.BoxProps{Class: "flex flex-col gap-4"}}) {
				for _, it := range o.Items {
					@compose.ListItem(compose.ListItemProps{BoxProps: box.BoxProps{Class: "flex flex-wrap items-center justify-between gap-4 rounded border border-border bg-card p-4", Attrs: templ.Attributes{"data-item": it.Slug, "data-access": it.Entitlement}}}) {
						@compose.Stack(compose.StackProps{Gap: "1"}) {
							@compose.Link(compose.LinkProps{LinkProps: link.LinkProps{Href: ProductHref(it.Slug), Class: "font-semibold"}}) {
								{ it.Title }
							}
							@compose.Text(compose.TextProps{Size: "sm", TextProps: text.TextProps{Class: "text-muted-foreground"}}) {
								{ licenseTitle(s, it.License) + " | " + s.T(accessKey(it.Entitlement)) }
							}
						}
						if it.Entitlement == "active" {
							@compose.LinkButton(compose.LinkButtonProps{LinkProps: link.LinkProps{Href: DownloadHref(it.Slug), Class: "gap-2", Attrs: templ.Attributes{"data-action": "download"}}}) {
								@icons.LucideIcon(icons.LucideIconProps{Name: "download", Size: 16})
								{ s.T("ui.account.download") }
							}
						}
					}
				}
			}
		}
	}
}
