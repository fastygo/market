# Copy to /etc/market/market.env (mode 0600, owner market). Placeholders only;
# never commit real values (ADR-0016).

# Storefront row to serve (storefronts.code)
MARKET_STOREFRONT=default
# Soft memory limit for the Go runtime (slo.md)
GOMEMLIMIT=512MiB

# HMAC key for /dl/{token} download links (32+ random bytes, base64)
MARKET_DOWNLOAD_SECRET=change-me

# Release files in S3-compatible storage (ADR-0009). Empty endpoint = local
# fake presigner (development only).
MARKET_S3_ENDPOINT=https://s3.example.com
MARKET_S3_REGION=ru-central-1
MARKET_S3_BUCKET=market-releases
MARKET_S3_ACCESS_KEY=change-me
MARKET_S3_SECRET_KEY=change-me
MARKET_S3_URL_TTL=5m

# Development only: enables the fake payment gateway and /fakepay routes.
# Must be 0 in production.
MARKET_FAKE_GATEWAY=0
# HMAC secret of the fake gateway webhooks (development only)
MARKET_FAKE_WEBHOOK_SECRET=change-me

# Public https origin of the storefront (return URLs, mail links, CSRF
# Origin check). Required with YooKassa.
MARKET_PUBLIC_URL=https://market.example.com
# Header with the client IP when behind a proxy or tunnel (YooKassa IP check)
MARKET_CLIENT_IP_HEADER=X-Forwarded-For

# YooKassa (ADR-0025). Empty shop id = adapter disabled.
MARKET_YOOKASSA_SHOP_ID=change-me
MARKET_YOOKASSA_SECRET_KEY=change-me
# 54-FZ receipts through YooKassa (1 default; 0 for a test store without
# the cash register mode)
MARKET_YOOKASSA_RECEIPTS=1
# Send return receipts with refunds (0 = YooKassa default scheme)
MARKET_YOOKASSA_REFUND_RECEIPTS=0
# Accept notifications only from YooKassa IP ranges (1 default)
MARKET_YOOKASSA_CHECK_IP=1
# Webhook URL to set in the shop: https://market.example.com/hooks/pay/yookassa

# Buyer cabinet (ADR-0027): HMAC key of magic links and CSRF tokens
# (32+ random bytes; keep stable across restarts)
MARKET_SESSION_SECRET=change-me
MARKET_TERMS_VERSION=1
MARKET_CHECKOUT_METHOD=card
# Development only: serve release files from a local directory via /files/
# MARKET_FILES_DIR=/var/lib/market/files

# Transactional mail (ADR-0026): file | unisender | resend
MARKET_MAIL_PROVIDER=file
MARKET_MAIL_API_KEY=change-me
MARKET_MAIL_FROM=shop@example.com
MARKET_MAIL_FROM_NAME=Market
# File mailer output directory (default pb_data/mail)
# MARKET_MAIL_DIR=/var/lib/market/mail
