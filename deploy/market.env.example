# Copy to /etc/market/market.env (mode 0600, owner market). Placeholders only;
# never commit real values (ADR-0016).

# Storefront row to serve (storefronts.code)
MARKET_STOREFRONT=default
# Soft memory limit for the Go runtime (slo.md)
GOMEMLIMIT=512MiB

# HMAC key for /dl/{token} download links (32+ random bytes, base64)
MARKET_DOWNLOAD_SECRET=change-me

# Release files in S3-compatible storage (ADR-0009). Empty endpoint = local
# fake presigner (development only).
MARKET_S3_ENDPOINT=https://s3.example.com
MARKET_S3_REGION=ru-central-1
MARKET_S3_BUCKET=market-releases
MARKET_S3_ACCESS_KEY=change-me
MARKET_S3_SECRET_KEY=change-me
MARKET_S3_URL_TTL=5m

# Development only: enables the fake payment gateway and /fakepay routes.
# Must be 0 in production.
MARKET_FAKE_GATEWAY=0

# Payment provider credentials (phase 1 provider not integrated yet):
# MARKET_PROVIDER_<CODE>_SHOP_ID=change-me
# MARKET_PROVIDER_<CODE>_SECRET=change-me
