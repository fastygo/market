# Copy to /etc/market/market.env (mode 0600, owner market). Placeholders only;
# never commit real values (ADR-0016).

# Storefront row to serve (storefronts.code)
MARKET_STOREFRONT=default
# Soft memory limit for the Go runtime (slo.md)
GOMEMLIMIT=512MiB

# Production is any start without MARKET_FAKE_GATEWAY=1 or MARKET_DEV=1:
# serve refuses to start when a required value below is missing or weak
# (HANDOFF.md, start-up checks). MARKET_DEV=1 keeps development defaults.
# MARKET_DEV=0

# HMAC key for /dl/{token} download links and /files signatures
# (required, 32+ characters, e.g. openssl rand -base64 48; differs from
# MARKET_SESSION_SECRET)
MARKET_DOWNLOAD_SECRET=change-me

# Release files (ADR-0009). Default: local files served on /files with
# signed, expiring links. Directory default <pb_data>/files.
MARKET_FILES_DIR=/var/lib/market/files
# Optional S3-compatible storage instead (set the endpoint to enable; then
# region, bucket and keys are required). Prefix = folder inside the bucket;
# storage keys stay relative to it.
# MARKET_S3_ENDPOINT=https://s3.example.com
# MARKET_S3_REGION=ru-1
# MARKET_S3_BUCKET=market-releases
# MARKET_S3_PREFIX=market/
# MARKET_S3_ACCESS_KEY=change-me
# MARKET_S3_SECRET_KEY=change-me
# MARKET_S3_PATH_STYLE=1
MARKET_S3_URL_TTL=5m

# Development only: enables the fake payment gateway and /fakepay routes.
# Must be 0 in production.
MARKET_FAKE_GATEWAY=0
# HMAC secret of the fake gateway webhooks (development only)
MARKET_FAKE_WEBHOOK_SECRET=change-me

# Public https origin of the storefront, no path (return URLs, mail links,
# CSRF Origin check). Required.
MARKET_PUBLIC_URL=https://market.example.com
# Reverse proxies allowed to set the client IP header (CIDRs or addresses,
# comma separated). The rightmost hop that is not listed is the client
# (YooKassa IP check, download IP hashes). Behind the Incus edge: its address.
MARKET_TRUSTED_PROXIES=10.10.40.10/32
# Header with the client IP (default X-Forwarded-For when proxies are set;
# ignored from peers outside MARKET_TRUSTED_PROXIES)
MARKET_CLIENT_IP_HEADER=X-Forwarded-For

# YooKassa (ADR-0025). Empty shop id = adapter disabled.
MARKET_YOOKASSA_SHOP_ID=change-me
MARKET_YOOKASSA_SECRET_KEY=change-me
# 54-FZ receipts through YooKassa (1 default; 0 for a test store without
# the cash register mode)
MARKET_YOOKASSA_RECEIPTS=1
# Send return receipts with refunds (0 = YooKassa default scheme)
MARKET_YOOKASSA_REFUND_RECEIPTS=0
# Accept notifications only from YooKassa IP ranges (1 default)
MARKET_YOOKASSA_CHECK_IP=1
# Webhook URL to set in the shop: https://market.example.com/hooks/pay/yookassa

# Buyer cabinet (ADR-0027): HMAC key of magic links and CSRF tokens
# (required, 32+ characters; keep stable across restarts)
MARKET_SESSION_SECRET=change-me
MARKET_TERMS_VERSION=1
MARKET_CHECKOUT_METHOD=card

# Transactional mail (ADR-0026): pocketbase (default) | unisender | resend | file
# pocketbase sends with the SMTP account from the admin UI (Settings > Mail
# settings), the same one PocketBase uses for verification and reset mail.
# While SMTP is off it writes .eml files to MARKET_MAIL_DIR.
MARKET_MAIL_PROVIDER=pocketbase
# Optional sender override (default: Settings > Application sender)
MARKET_MAIL_FROM=shop@example.com
MARKET_MAIL_FROM_NAME=Market
# Use local sendmail while SMTP is off instead of the file fallback
# MARKET_MAIL_SENDMAIL=1
# Only for unisender and resend
# MARKET_MAIL_API_KEY=change-me
# File mailer output directory (default pb_data/mail)
# MARKET_MAIL_DIR=/var/lib/market/mail
